<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <queries><package android:name="com.TotalPlay.totalplay" /></queries>
    <application android:label="Totalplay D-pad Pointer" android:theme="@android:style/Theme.Material.NoActionBar" android:banner="@drawable/tv_banner" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Separate TV app-row tile. Keeps the original signed Totalplay APK untouched. -->
        <activity android:name=".TotalplayLauncherActivity"
            android:label="Totalplay TV+"
            android:banner="@drawable/tv_banner"
            android:exported="true"
            android:noHistory="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".TotalplayPointerService" android:label="Totalplay D-pad Pointer" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/totalplay_pointer_accessibility" />
        </service>
    </application>
</manifest>
